# Copy to .env for local work. On Render, set these in the dashboard.
AT_USERNAME=sandbox
AT_API_KEY=
# Leave empty in the sandbox: AT refuses an empty or unknown sender id.
AT_SHORTCODE=
# Receives every "not sure", HELP/AGENT request and "3 = worse" follow-up.
AGENT_PHONE=+2567XXXXXXXX
# 1 = never call Africa's Talking (local demo). 0 on the deployed server.
DEMO_MODE=0
# 1 = translation + classifier + LLM. 0 = keyword stub, no model needed.
USE_REAL_AI=1
# LLM second opinion: an Ollama server with qwen2.5:3b. USE_LLM=0 to skip it.
USE_LLM=1
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Converted NLLB-200-600M (CTranslate2 int8), downloaded by scripts/fetch_models.py
NLLB_CT2_REPO=JustFrederik/nllb-200-distilled-600M-ct2-int8
# Optional: one real number the demo page may drive end to end through AT.
DEMO_LIVE_PHONE=
# English subtitles on the demo page (judges only). Empty -> Google's free endpoint.
GOOGLE_TRANSLATE_API_KEY=
FRONTEND_ORIGIN=*
DB_PATH=data/app.db
